<misterromdescription>
	<!-- Expansion board: heart-rate / skin-response sensors and printer (MAME 0.289 machine "tmosh"). Disc: mount 673jaa01.chd (MAME set, unchanged) from
	     /media/fat/games/tmosh/ with "Mount GV Disc". -->
	<name>Tokimeki Memorial Oshiete Your Heart (GQ673 JAA)</name>
	<setname>tmosh</setname>
	<rbf>KonamiGV</rbf>
	<mameversion>0289</mameversion>
	<year>1997</year>
	<manufacturer>Konami</manufacturer>
	<category>Simulation</category>
	<region>Japan</region>
	<players>1</players>
	<joystick>8-way</joystick>
	<rotation>horizontal</rotation>
	<rom index="0" zip="tmosh.zip|konamigv.zip" md5="None">
		<part name="999a01.7e" crc="ad498d2d"/>
	</rom>
	<!-- Board config -> ioctl index 4: bit 3 = Tokimeki board -->
	<rom index="4">
		<part>08</part>
	</rom>
	<rom index="3" zip="tmosh.zip" md5="None">
		<part name="tmosh.25c" crc="2f6a27fc"/>
	</rom>
	<nvram index="3" size="128"/>
	<buttons names="Button 1,-,-,Start,Coin,Service,Test" default="A,B,X,Start,Select,R,L"/>
	<!-- Sensors: the heart-rate sensor is simulated at the OSD "Heart Rate" setting (Hand Off = no hand on
	     the sensor); the skin-response (GSR) level follows the P1 left analog stick pulled down.
	     The printer reports ready with paper; printouts are discarded. -->
</misterromdescription>
